{
  // 引擎核心：lib 只有 ES2022，没有 DOM。核心代码里写 window / document / wx 会直接类型报错。
  // 平台相关代码放在 src/platform/<name>/，由各自的 tsconfig（如 tsconfig.browser.json）引入 DOM 或 wx 的类型。
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/platform/browser", "src/platform/wechat", "src/vite"]
}
